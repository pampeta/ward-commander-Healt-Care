# =========================================================
# WARD COMMANDER - CONFIGURACIÓN DE ENTORNO
# =========================================================

# 1. API Key de Google Gemini (Requerido para el asistente de IA y OCR)
# Obtén tu clave gratuita en: https://aistudio.google.com/
VITE_GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# 2. Supabase (Opcional - Para persistencia y sincronización en la nube)
# Si no se configuran, la aplicación funcionará con almacenamiento LocalStorage del navegador.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_supabase
